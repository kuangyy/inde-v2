# 站点对外域名（可带或不带 https://，必填）
DOMAIN=127.0.0.1:18080

# 后台登录密码（必填，至少 8 位，建议 16 位以上随机字符串）
ADMIN_PASSWORD=change-me-please

# 容器内监听端口（一般不用改）
PORT=18080

# 数据目录：SQLite 数据库 + 上传图片都在这里
DATA_DIR=/data

# HTTPS 部署保持 true；仅用 http://IP:端口 访问时设为 false
COOKIE_SECURE=true

# 是否允许玩家注册
ALLOW_REGISTRATION=true

# 日志级别
RUST_LOG=info

# 可选：使用 GHCR 上的 CI 镜像时填写，例如 ghcr.io/owner/inde-rs:latest
# 留空则 docker compose 使用本地构建的 inde-rs:local
# INDE_IMAGE=ghcr.io/<owner>/<repo>:latest
